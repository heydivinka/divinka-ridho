{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'exp-pdp-custom.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .exp-smart-description-section {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="exp-smart-description-section">
      {% render 'exp-smart-description', product: product, section: section %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "EXP Smart Description",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Skema Warna",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Lebar Maksimum Kontainer",
      "default": 960
    },
    {
      "type": "header",
      "content": "1. Smart Description (Dinamis)"
    },
    {
      "type": "paragraph",
      "content": "Box checklist (Heading 'Termasuk/Kelengkapan' + bullet list) dan tab accordion (Heading H2/H3 lainnya) diproses 100% otomatis dari Description produk di Shopify Admin."
    },
    {
      "type": "checkbox",
      "id": "show_included_box",
      "label": "Tampilkan Box Checklist Pembelian",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_first_accordion",
      "label": "Buka Tab Accordion Pertama Secara Default",
      "default": true
    },
    {
      "type": "header",
      "content": "2. Komentar Pembeli Terverifikasi"
    },
    {
      "type": "checkbox",
      "id": "show_testimonial",
      "label": "Tampilkan Komentar Pembeli Terverifikasi",
      "default": true
    },
    {
      "type": "text",
      "id": "testimonial_initials",
      "label": "Inisial Avatar",
      "default": "AS"
    },
    {
      "type": "text",
      "id": "testimonial_author",
      "label": "Nama Pembeli",
      "default": "Amanda S."
    },
    {
      "type": "text",
      "id": "testimonial_badge",
      "label": "Teks Badge Verifikasi",
      "default": "Pembeli Terverifikasi"
    },
    {
      "type": "textarea",
      "id": "testimonial_quote",
      "label": "Kutipan Ulasan",
      "default": "“Wajan terbaik yang pernah saya beli! Telur meluncur mulus tanpa minyak banyak, mudah dicuci, dan warnanya bikin meja dapur terlihat mewah.”"
    },
    {
      "type": "header",
      "content": "Pengaturan Spacing Section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Atas",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bawah",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "accordion_tab",
      "name": "Tab Accordion Tambahan",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "options": [
            {
              "value": "cookware",
              "label": "Panci / Tas (Deskripsi)"
            },
            {
              "value": "shield",
              "label": "Perisai (Spesifikasi & Material)"
            },
            {
              "value": "clock",
              "label": "Jam (Garansi & Uji Coba)"
            }
          ],
          "default": "cookware"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Judul Tab",
          "default": "Informasi Tambahan"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Konten Tab"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Atau Pilih Halaman"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EXP Smart Description",
      "blocks": []
    }
  ]
}
{% endschema %}
