{% comment %}
  Modern Luxury Cookware Cart Drawer Snippet
  Inspired by Our Place & Figma Design
  Usage: {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

{%- liquid
  # Detect section and blocks
  assign has_blocks = false
  assign shipping_bar_block = nil
  assign promo_banner_block = nil
  assign cart_items_block = nil
  assign upsell_block = nil
  assign order_summary_block = nil
  assign trust_badges_block = nil
  assign empty_cart_block = nil

  if section != nil and section.blocks.size > 0
    assign has_blocks = true
    for block in section.blocks
      case block.type
        when 'shipping_bar'
          assign shipping_bar_block = block
        when 'promo_banner'
          assign promo_banner_block = block
        when 'cart_items'
          assign cart_items_block = block
        when 'upsell'
          assign upsell_block = block
        when 'order_summary'
          assign order_summary_block = block
        when 'trust_badges'
          assign trust_badges_block = block
        when 'empty_cart'
          assign empty_cart_block = block
      endcase
    endfor
  endif

  # Threshold configuration from Section Settings or Theme Settings
  assign raw_threshold = section.settings.free_shipping_threshold | default: settings.free_shipping_threshold
  if raw_threshold == blank or raw_threshold <= 0
    assign raw_threshold = 2000000
  endif
  # Handle both plain Rupiah (e.g. 2000000) and subunit cents (e.g. 200000000)
  if raw_threshold > 50000000
    assign threshold_amount = raw_threshold
  else
    assign threshold_amount = raw_threshold | times: 100
  endif

  # Use the same threshold whether cart is empty or has items
  assign empty_threshold_amount = threshold_amount

  # Estimasi Ongkos Kirim Standar (Regular Shipping Fee)
  assign raw_shipping_fee = section.settings.estimated_shipping_fee | default: settings.estimated_shipping_fee
  if raw_shipping_fee == blank or raw_shipping_fee <= 0
    assign raw_shipping_fee = 25000
  endif
  if raw_shipping_fee > 5000000
    assign shipping_fee_amount = raw_shipping_fee
  else
    assign shipping_fee_amount = raw_shipping_fee | times: 100
  endif

  assign shipping_saved_text = section.settings.free_shipping_cost_saved | default: settings.free_shipping_cost_saved | default: 'Rp 25.000'
  assign drawer_heading = section.settings.heading | default: 'Keranjang Belanja'
  assign drawer_color_scheme = section.settings.color_scheme | default: settings.cart_color_scheme | default: 'scheme-1'

  assign enable_free_shipping = true
  if section.settings.enable_free_shipping == false
    assign enable_free_shipping = false
  elsif has_blocks and shipping_bar_block == nil
    assign enable_free_shipping = false
  elsif settings.enable_free_shipping_bar == false and has_blocks == false
    assign enable_free_shipping = false
  endif

  if cart.total_price >= threshold_amount and cart != empty
    assign is_free_shipping = true
    assign progress_pct = 100
    assign remaining_amount = 0
    assign final_total = cart.total_price
  elsif cart != empty
    assign is_free_shipping = false
    assign progress_pct = cart.total_price | times: 100 | divided_by: threshold_amount
    if progress_pct > 99
      assign progress_pct = 95
    endif
    assign remaining_amount = threshold_amount | minus: cart.total_price
    assign final_total = cart.total_price | plus: shipping_fee_amount
  else
    assign is_free_shipping = false
    assign progress_pct = 0
    assign remaining_amount = empty_threshold_amount
    assign final_total = 0
  endif
-%}

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner cd-drawer__inner gradient color-{{ drawer_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <!-- Cart Drawer Header -->
      <div class="cd-header">
        <div class="cd-header__title-wrap">
          <h2 class="cd-header__title">{{ drawer_heading }}</h2>
          <span class="cd-header__badge">{{ cart.item_count }} Item</span>
        </div>
        <button
          class="cd-header__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Free Shipping Progress Bar -->
      {%- if enable_free_shipping -%}
      <div class="cd-shipping-bar" {{ shipping_bar_block.shopify_attributes }}>
        <div class="cd-shipping-bar__meta">
          <div class="cd-shipping-bar__meta-left">
            {%- if is_free_shipping -%}
              <span>🎉 <strong>{{ shipping_bar_block.settings.celebration_text | default: section.settings.celebration_text | default: 'Selamat! Kamu mendapatkan Bebas Ongkos Kirim!' }}</strong></span>
            {%- elsif cart == empty -%}
              <span class="cd-icon-shipping">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </span>
              <span>Belanja minimal {{ empty_threshold_amount | money }} untuk <strong>Gratis Ongkir!</strong></span>
            {%- else -%}
              <span class="cd-icon-shipping">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              </span>
              <span>Tambah <strong>{{ remaining_amount | money }}</strong> lagi untuk <strong>Gratis Ongkir!</strong></span>
            {%- endif -%}
          </div>
          <div class="cd-shipping-bar__meta-right{% if is_free_shipping %} is-complete{% endif %}">
            {{ progress_pct }}%
          </div>
        </div>

        <div class="cd-shipping-bar__track">
          <div
            class="cd-shipping-bar__fill{% if is_free_shipping %} is-complete{% endif %}"
            data-target-pct="{{ progress_pct }}"
            style="--cd-target-width: {{ progress_pct }}%;{% if is_free_shipping %} background: #158348 !important; background-color: #158348 !important;{% else %} background: linear-gradient(90deg, #E27B58 0%, #BA5635 100%) !important; background-color: #BA5635 !important;{% endif %}"
          ></div>
        </div>

        {%- liquid
          assign show_promo_banner = false
          if promo_banner_block != nil
            assign show_promo_banner = true
          elsif has_blocks == false and section.settings.show_promo_banner != false and settings.show_promo_banner != false
            assign show_promo_banner = true
          endif
        -%}
        {%- if is_free_shipping -%}
          <div class="cd-shipping-bar__success-sub">
            <span class="cd-shipping-bar__success-sub-left">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Otomatis diterapkan di kasir
            </span>
            <span class="cd-shipping-bar__success-sub-right">Hemat: {{ shipping_saved_text }}</span>
          </div>
        {%- elsif cart != empty and show_promo_banner -%}
          {%- liquid
            assign promo_text = promo_banner_block.settings.text | default: section.settings.promo_banner_text | default: settings.promo_banner_text | default: 'Hemat setiap Rp 1.100.000 dengan kupon'
            assign promo_badge = promo_banner_block.settings.tag_label | default: section.settings.promo_banner_badge | default: settings.promo_banner_badge | default: 'Dinikmati 100x'
          -%}
          <div class="cd-promo-banner" {{ promo_banner_block.shopify_attributes }}>
            <div class="cd-promo-banner__left">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              <span>{{ promo_text }}</span>
            </div>
            <div class="cd-promo-banner__right">{{ promo_badge }}</div>
          </div>
        {%- endif -%}
      </div>

      <script>
        (function() {
          function runCdBarAnimation() {
            var fills = document.querySelectorAll('.cd-shipping-bar__fill');
            fills.forEach(function(fill) {
              var targetPct = fill.getAttribute('data-target-pct') || '0';
              fill.style.width = '0%';
              requestAnimationFrame(function() {
                setTimeout(function() {
                  fill.style.width = targetPct + '%';
                }, 40);
              });
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', runCdBarAnimation);
          } else {
            runCdBarAnimation();
          }

          var cdDrawer = document.querySelector('cart-drawer');
          if (cdDrawer && !window._cdBarObserverAttached) {
            window._cdBarObserverAttached = true;
            var obs = new MutationObserver(function(muts) {
              for (var i = 0; i < muts.length; i++) {
                if (muts[i].type === 'attributes' && muts[i].attributeName === 'class') {
                  if (cdDrawer.classList.contains('active')) {
                    runCdBarAnimation();
                  }
                }
              }
            });
            obs.observe(cdDrawer, { attributes: true });
          }
        })();
      </script>
      {%- endif -%}

      <!-- Main Scrollable Body -->
      <div class="cd-main-scroll">
        {%- if cart == empty -%}
          <!-- Empty State -->
          {%- liquid
            assign empty_heading = empty_cart_block.settings.heading | default: section.settings.empty_cart_heading | default: settings.empty_cart_heading | default: 'Keranjang Belanja Anda Kosong'
            assign empty_desc = empty_cart_block.settings.description | default: section.settings.empty_cart_text | default: settings.empty_cart_text | default: 'Sepertinya Anda belum menambahkan peralatan dapur impian ke dalam keranjang. Temukan koleksi terbaik kami!'
            assign empty_btn_text = empty_cart_block.settings.button_text | default: section.settings.empty_cart_btn_text | default: settings.empty_cart_btn_text | default: 'Mulai Jelajahi Produk'
            assign empty_btn_link = empty_cart_block.settings.button_link | default: section.settings.empty_cart_btn_url | default: settings.empty_cart_btn_url | default: routes.all_products_collection_url
            assign empty_rec_heading = empty_cart_block.settings.recommendations_heading | default: section.settings.empty_cart_rec_heading | default: 'REKOMENDASI TERPOPULER'
            assign empty_rec_limit = empty_cart_block.settings.products_to_show | default: section.settings.empty_cart_products_count | default: 3
            assign empty_collection = empty_cart_block.settings.collection | default: section.settings.cart_drawer_collection | default: settings.cart_drawer_collection
            assign empty_help_text = empty_cart_block.settings.help_text | default: section.settings.support_phone_text | default: settings.support_phone_text | default: 'Butuh bantuan memilih? Hubungi Layanan Pelanggan 24/7'
            assign empty_help_link = empty_cart_block.settings.help_link | default: section.settings.support_phone_url | default: settings.support_phone_url | default: '/pages/contact'
          -%}
          <div class="cd-empty drawer__inner-empty" {{ empty_cart_block.shopify_attributes }}>
            <div class="cd-empty__icon-wrap">
              <svg width="44" height="44" viewBox="0 0 48 48" fill="none" stroke="#BA5635" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 22C10 31 16 38 24 38C32 38 38 31 38 22H10Z" fill="#FDF3EB"/>
                <path d="M7 22H41"/>
                <path d="M12 17C14 13 18 11 24 11C30 11 34 13 36 17H12Z"/>
                <circle cx="24" cy="8" r="2.5" fill="#BA5635"/>
                <path d="M5 24C3.5 24 3 26 3 27C3 28 3.5 30 5 30"/>
                <path d="M43 24C44.5 24 45 26 45 27C45 28 44.5 30 43 30"/>
              </svg>
            </div>
            <h3 class="cd-empty__title">{{ empty_heading }}</h3>
            <p class="cd-empty__desc">{{ empty_desc }}</p>
            <a href="{{ empty_btn_link }}" class="cd-btn-primary">
              {{ empty_btn_text }} &rarr;
            </a>

            <!-- Rekomendasi Terpopuler -->
            <div class="cd-recommendations">
              <div class="cd-recommendations__header">
                <span class="cd-recommendations__title">{{ empty_rec_heading }}</span>
                <a href="{{ routes.all_products_collection_url }}" class="cd-recommendations__link">Lihat Semua</a>
              </div>

              {%- liquid
                assign recom_count = 0
                if empty_collection != blank and empty_collection.products.size > 0
                  for p in empty_collection.products limit: empty_rec_limit
                    assign recom_count = recom_count | plus: 1
                    render 'cart-recom-card', product: p
                  endfor
                elsif collections.all.products.size > 0
                  for p in collections.all.products limit: empty_rec_limit
                    assign recom_count = recom_count | plus: 1
                    render 'cart-recom-card', product: p
                  endfor
                endif
              -%}

              {%- if recom_count < 3 -%}
                <!-- Curated Cookware Items matching Figma Design -->
                <div class="cd-recom-card">
                  <div class="cd-recom-card__left">
                    <div class="cd-recom-card__img">
                      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="#BA5635" stroke-width="1.8">
                        <ellipse cx="14" cy="16" rx="9" ry="6"/>
                        <path d="M23 16L29 18"/>
                      </svg>
                    </div>
                    <div class="cd-recom-card__info">
                      <div class="cd-recom-card__title-row">
                        <span class="cd-recom-card__name">Always Pan 2.0</span>
                        <span class="cd-badge-gold">Best Seller</span>
                      </div>
                      <span class="cd-recom-card__price">Rp 1.650.000</span>
                    </div>
                  </div>
                  <a href="{{ routes.all_products_collection_url }}" class="cd-btn-outline-pill">Lihat Produk</a>
                </div>

                <div class="cd-recom-card">
                  <div class="cd-recom-card__left">
                    <div class="cd-recom-card__img">
                      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="#BA5635" stroke-width="1.8">
                        <path d="M7 14C7 21 11 25 16 25C21 25 25 21 25 14H7Z"/>
                        <path d="M5 14H27"/>
                        <circle cx="16" cy="10" r="1.5" fill="#BA5635"/>
                      </svg>
                    </div>
                    <div class="cd-recom-card__info">
                      <div class="cd-recom-card__title-row">
                        <span class="cd-recom-card__name">Perfect Pot</span>
                      </div>
                      <span class="cd-recom-card__price">Rp 1.850.000</span>
                    </div>
                  </div>
                  <a href="{{ routes.all_products_collection_url }}" class="cd-btn-outline-pill">Lihat Produk</a>
                </div>

                <div class="cd-recom-card">
                  <div class="cd-recom-card__left">
                    <div class="cd-recom-card__img">
                      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="#BA5635" stroke-width="1.8">
                        <path d="M6 24L18 12L25 12L22 17L12 24H6Z"/>
                        <line x1="18" y1="12" x2="26" y2="6"/>
                      </svg>
                    </div>
                    <div class="cd-recom-card__info">
                      <div class="cd-recom-card__title-row">
                        <span class="cd-recom-card__name">Everyday Chef's Knife</span>
                      </div>
                      <span class="cd-recom-card__price">Rp 550.000</span>
                    </div>
                  </div>
                  <a href="{{ routes.all_products_collection_url }}" class="cd-btn-outline-pill">Lihat Produk</a>
                </div>
              {%- endif -%}
            </div>

            <!-- Empty footer support note -->
            <div class="cd-empty__footer-note">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
              <span><a href="{{ empty_help_link }}">{{ empty_help_text }}</a></span>
            </div>
          </div>
        {%- else -%}
          <!-- Active Cart State: Cart Items -->
          <cart-drawer-items
            view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
            view-event-trigger="manual"
          >
            <form
              action="{{ routes.cart_url }}"
              id="CartDrawer-Form"
              class="cart__contents cart-drawer__form"
              method="post"
            >
              <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
                <div class="cart-items cd-items-list" {{ cart_items_block.shopify_attributes }}>
                  {%- for item in cart.items -%}
                    <div
                      id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                      class="cart-item cd-item-card"
                    >
                      <!-- Item Media (Square Thumbnail 64x64) -->
                      <div class="cd-item__media">
                        {% if item.image %}
                          <img
                            class="cd-item__image"
                            src="{{ item.image | image_url: width: 140 }}"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="64"
                            height="64"
                          >
                        {% else %}
                          <div class="cd-item__image" style="background: #F4EFEB; display:flex; align-items:center; justify-content:center; width:100%; height:100%;">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#BA5635" stroke-width="1.5">
                              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                              <circle cx="8.5" cy="8.5" r="1.5"/>
                              <polyline points="21 15 16 10 5 21"/>
                            </svg>
                          </div>
                        {% endif %}
                      </div>

                      <!-- Item Content Column -->
                      <div class="cd-item__content">
                        <!-- Top Row: Title & Remove Trash Button -->
                        <div class="cd-item__top-row">
                          <a href="{{ item.url }}" class="cd-item__title">
                            {{- item.product.title | escape -}}
                          </a>
                          <cart-remove-button
                            id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                          >
                            <button
                              type="button"
                              class="cd-remove-btn"
                              aria-label="Hapus {{ item.title | escape }}"
                              data-variant-id="{{ item.variant.id }}"
                            >
                              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6V20C19 21.1 18.1 22 17 22H7C5.9 22 5 21.1 5 20V6M8 6V4C8 2.9 8.9 2 10 2H14C15.1 2 16 2.9 16 4V6"></path>
                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                <line x1="14" y1="11" x2="14" y2="17"></line>
                              </svg>
                            </button>
                          </cart-remove-button>
                        </div>

                        {%- assign show_vendor = false -%}
                        {%- if cart_items_block.settings.show_vendor or section.settings.show_vendor -%}
                          {%- assign show_vendor = true -%}
                        {%- endif -%}
                        {%- if show_vendor and item.product.vendor != blank -%}
                          <div class="cd-item__vendor" style="font-size: 11px; color: #8C827A; margin-bottom: 2px;">{{ item.product.vendor | escape }}</div>
                        {%- endif -%}

                        {%- assign show_change = true -%}
                        {%- if cart_items_block != nil and cart_items_block.settings.show_change_link == false -%}
                          {%- assign show_change = false -%}
                        {%- elsif section.settings.show_change_link == false -%}
                          {%- assign show_change = false -%}
                        {%- endif -%}

                        <!-- Variant Info -->
                        {%- if item.product.has_only_default_variant == false -%}
                          <div class="cd-item__variant-tag">
                            <span class="cd-variant-dot"></span>
                            <span>
                              {%- for option in item.options_with_values -%}
                                {{ option.name }}: {{ option.value }}{% unless forloop.last %}, {% endunless %}
                              {%- endfor -%}
                            </span>
                            {%- if show_change -%}
                              <a href="{{ item.url }}" class="cd-item__change">Ubah</a>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                        <!-- Bottom Row: Price & Quantity Stepper -->
                        <div class="cd-item__bottom-row">
                          <div class="cd-item__price-wrap">
                            <span class="cd-item__price">{{ item.final_price | money }}</span>
                            {%- if item.original_price != item.final_price -%}
                              <s class="cd-item__old-price">{{ item.original_price | money }}</s>
                            {%- elsif item.variant.compare_at_price > item.final_price -%}
                              <s class="cd-item__old-price">{{ item.variant.compare_at_price | money }}</s>
                            {%- endif -%}
                          </div>

                          <!-- Quantity Stepper Pill -->
                          <div class="cd-item__actions">
                            <quantity-popover>
                              <div class="quantity-popover-wrapper">
                                <quantity-input class="cd-qty-pill">
                                  <button
                                    class="cd-qty-btn"
                                    name="minus"
                                    type="button"
                                    aria-label="Kurangi kuantitas"
                                  >
                                    &minus;
                                  </button>
                                  <input
                                    class="cd-qty-input"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    data-quantity-line-key="{{ item.key }}"
                                    name="updates[]"
                                    value="{{ item.quantity }}"
                                    min="0"
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    aria-label="Kuantitas"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                  >
                                  <button
                                    class="cd-qty-btn"
                                    name="plus"
                                    type="button"
                                    aria-label="Tambah kuantitas"
                                  >
                                    +
                                  </button>
                                </quantity-input>
                              </div>
                            </quantity-popover>
                          </div>
                        </div>

                        <!-- Line Item Error -->
                        <div
                          id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                          class="cart-item__error"
                          role="alert"
                        >
                          <small class="cart-item__error-text"></small>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>

              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
                {{ 'accessibility.loading' | t }}
              </p>
              <div id="CartDrawer-CartErrors" role="alert"></div>
            </form>
          </cart-drawer-items>

          <!-- Cross-sell / Upsell Section ("LENGKAPI DAPURMU") -->
          {%- assign show_upsell = true -%}
          {%- if section.settings.show_cart_upsell == false or settings.show_cart_upsell == false -%}
            {%- assign show_upsell = false -%}
          {%- elsif has_blocks and upsell_block == nil -%}
            {%- assign show_upsell = false -%}
          {%- endif -%}
          {%- if show_upsell -%}
          {%- liquid
            assign upsell_heading = upsell_block.settings.heading | default: section.settings.cart_upsell_heading | default: settings.cart_upsell_heading | default: 'LENGKAPI DAPURMU'
            assign upsell_subheading = upsell_block.settings.subtitle | default: section.settings.cart_upsell_subheading | default: settings.cart_upsell_subheading | default: 'Penawaran Eksklusif Keranjang'
            assign upsell_desc = upsell_block.settings.item_desc | default: section.settings.cart_upsell_desc | default: 'Koleksi serbaguna terbaik'
            assign upsell_btn_text = upsell_block.settings.button_label | default: section.settings.cart_upsell_btn_text | default: '+ Tambah'
            assign custom_upsell_prod = upsell_block.settings.product | default: section.settings.cart_upsell_product | default: settings.cart_upsell_product
            assign custom_upsell_col = upsell_block.settings.collection | default: section.settings.cart_drawer_collection | default: settings.cart_drawer_collection
          -%}
          <div class="cd-upsell-section" {{ upsell_block.shopify_attributes }}>
            <div class="cd-upsell__header">
              <span class="cd-upsell__title">{{ upsell_heading }}</span>
              <span class="cd-upsell__subtitle">{{ upsell_subheading }}</span>
            </div>

            {%- liquid
              assign upsell_product = nil
              if custom_upsell_prod != blank and custom_upsell_prod.available
                assign in_cart = false
                for it in cart.items
                  if it.product_id == custom_upsell_prod.id
                    assign in_cart = true
                    break
                  endif
                endfor
                if in_cart == false
                  assign upsell_product = custom_upsell_prod
                endif
              endif

              if upsell_product == nil
                assign store_prods = nil
                if custom_upsell_col != blank and custom_upsell_col.products.size > 0
                  assign store_prods = custom_upsell_col.products
                elsif collections['all'] != blank and collections['all'].products.size > 0
                  assign store_prods = collections['all'].products
                elsif collections['rido-ganteng'] != blank and collections['rido-ganteng'].products.size > 0
                  assign store_prods = collections['rido-ganteng'].products
                else
                  for col in collections
                    if col.products.size > 0
                      assign store_prods = col.products
                      break
                    endif
                  endfor
                endif

                if store_prods != nil
                  for p in store_prods
                    assign in_cart = false
                    for it in cart.items
                      if it.product_id == p.id
                        assign in_cart = true
                        break
                      endif
                    endfor
                    if in_cart == false and p.available
                      assign upsell_product = p
                      break
                    endif
                  endfor
                endif
              endif
            -%}

            {%- if upsell_product != nil -%}
              <div class="cd-upsell__card">
                <div class="cd-upsell__card-left">
                  {%- if upsell_product.featured_image -%}
                    <img
                      class="cd-upsell__img"
                      src="{{ upsell_product.featured_image | image_url: width: 100 }}"
                      alt="{{ upsell_product.title | escape }}"
                      width="44"
                      height="44"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="cd-upsell__img" style="display:flex;align-items:center;justify-content:center;background:#FAF6F2;">
                      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" stroke="#BA5635" stroke-width="1.8">
                        <path d="M7 14C7 21 11 25 16 25C21 25 25 21 25 14H7Z"/>
                        <path d="M5 14H27"/>
                      </svg>
                    </div>
                  {%- endif -%}
                  <div class="cd-upsell__info">
                    <span class="cd-upsell__name">{{ upsell_product.title | escape }}</span>
                    <span class="cd-upsell__desc">{{ upsell_desc }}</span>
                    <div class="cd-upsell__price-wrap">
                      <span class="cd-upsell__price">{{ upsell_product.price | money }}</span>
                      {%- if upsell_product.compare_at_price > upsell_product.price -%}
                        <span class="cd-upsell__old-price">{{ upsell_product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                <button
                  type="button"
                  class="cd-upsell__btn"
                  onclick="addCrossSellItem(this, '{{ upsell_product.first_available_variant.id }}')"
                >
                  {{ upsell_btn_text }}
                </button>
              </div>
            {%- endif -%}
          </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <!-- Drawer Footer (Order Summary & Checkout) -->
      {%- if cart != empty -%}
        <div class="drawer__footer cd-drawer__footer" {{ order_summary_block.shopify_attributes }}>
          <div class="cart-drawer__footer">
            {%- liquid
              assign total_savings = cart.total_discount
              assign original_subtotal = 0
              for item in cart.items
                if item.variant.compare_at_price > item.final_price
                  assign diff = item.variant.compare_at_price | minus: item.final_price | times: item.quantity
                  assign total_savings = total_savings | plus: diff
                  assign line_orig = item.variant.compare_at_price | times: item.quantity
                  assign original_subtotal = original_subtotal | plus: line_orig
                else
                  assign line_orig = item.final_price | times: item.quantity
                  assign original_subtotal = original_subtotal | plus: line_orig
                endif
              endfor

              assign checkout_btn_text = order_summary_block.settings.button_label | default: section.settings.cart_checkout_button_text | default: settings.cart_checkout_button_text | default: 'Lanjut ke Pembayaran'
              assign checkout_tax_note = order_summary_block.settings.tax_note | default: section.settings.cart_tax_note | default: settings.cart_tax_note | default: 'Termasuk PPN & asuransi pengiriman'
            -%}

            <!-- Subtotal -->
            <div class="cd-summary-row">
              <span class="cd-summary-row__label">
                Subtotal ({% if cart.item_count == 1 %}1 Item{% else %}{{ cart.item_count }} Item{% endif %})
              </span>
              <span class="cd-summary-row__value">
                {%- if original_subtotal > cart.total_price -%}
                  {{ original_subtotal | money }}
                {%- else -%}
                  {{ cart.items_subtotal_price | money }}
                {%- endif -%}
              </span>
            </div>

            <!-- Discount Row (if applicable) -->
            {%- if total_savings > 0 -%}
              <div class="cd-summary-row">
                <span class="cd-summary-row__label" style="color: var(--cd-green);">Diskon Promo Paket</span>
                <span class="cd-summary-row__value is-discount">-{{ total_savings | money }}</span>
              </div>
            {%- endif -%}

            <!-- Shipping Cost Row -->
            {%- assign show_shipping = true -%}
            {%- if order_summary_block != nil and order_summary_block.settings.show_shipping_row == false -%}
              {%- assign show_shipping = false -%}
            {%- elsif section.settings.show_shipping_row == false -%}
              {%- assign show_shipping = false -%}
            {%- endif -%}
            {%- if show_shipping -%}
            <div class="cd-summary-row">
              <span class="cd-summary-row__label">Estimasi Ongkos Kirim</span>
              <div class="cd-summary-row__value">
                {%- if is_free_shipping -%}
                  <span class="cd-badge-free">Bebas Ongkir</span>
                  <s style="color: #9E968F; font-size: 11.5px; margin-right: 4px;">{{ shipping_fee_amount | money }}</s>
                  <strong class="cd-text-free">GRATIS</strong>
                {%- else -%}
                  <span>{{ shipping_fee_amount | money }}</span>
                {%- endif -%}
              </div>
            </div>
            {%- endif -%}

            <div class="cd-summary-divider"></div>

            <!-- Total Payment -->
            <div class="cd-total-row">
              <span class="cd-total-row__label">Total Pembayaran</span>
              <span class="cd-total-row__value">{{ final_total | money_with_currency }}</span>
            </div>
            <div class="cd-summary-note">{{ checkout_tax_note }}</div>

            <!-- Checkout CTA Button -->
            <div class="cart__ctas">
              <form action="{{ routes.cart_url }}" method="post" id="CartDrawer-Checkout-Form" style="width: 100%; margin: 0;">
                <input type="hidden" name="checkout" value="1">
                <button
                  type="submit"
                  id="CartDrawer-Checkout"
                  class="cart__checkout-button cd-btn-checkout"
                  name="checkout"
                  onclick="handleCheckoutClick(event)"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <span>{{ checkout_btn_text }} &rarr;</span>
                </button>
              </form>
            </div>

            {%- assign show_badges = true -%}
            {%- if section.settings.show_trust_badges == false or settings.show_trust_badges == false -%}
              {%- assign show_badges = false -%}
            {%- elsif has_blocks and trust_badges_block == nil -%}
              {%- assign show_badges = false -%}
            {%- endif -%}
            {%- if show_badges -%}
              {%- liquid
                assign badge_1 = trust_badges_block.settings.badge_1 | default: section.settings.trust_badge_1 | default: settings.trust_badge_1 | default: 'Garansi Uji Coba 100 Hari'
                assign badge_2 = trust_badges_block.settings.badge_2 | default: section.settings.trust_badge_2 | default: settings.trust_badge_2 | default: 'Cicilan 0% Tersedia'
                assign badge_3 = trust_badges_block.settings.badge_3 | default: section.settings.trust_badge_3 | default: settings.trust_badge_3 | default: 'Bebas Ongkir Aktif'
              -%}
              <!-- Trust Badges -->
              <div class="cd-trust-badges" {{ trust_badges_block.shopify_attributes }}>
                {%- if badge_1 != blank -%}
                  <div class="cd-trust-badge">
                    <span>🛡️</span>
                    <span>{{ badge_1 }}</span>
                  </div>
                {%- endif -%}
                {%- if badge_2 != blank -%}
                  <div class="cd-trust-badge">
                    <span>• 💳</span>
                    <span>{{ badge_2 }}</span>
                  </div>
                {%- endif -%}
                {%- if is_free_shipping and badge_3 != blank -%}
                  <div class="cd-trust-badge" style="color: var(--cd-green); font-weight: 600;">
                    <span>• 🚚</span>
                    <span>{{ badge_3 }}</span>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}

            <!-- Render Any Third-Party App Blocks -->
            {%- if section.blocks != blank -%}
              {%- for block in section.blocks -%}
                {%- if block.type == '@app' -%}
                  <div class="cd-app-block" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

<script>
  function handleCheckoutClick(e) {
    var rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var checkoutUrl = rootUrl.endsWith('/') ? rootUrl + 'checkout' : rootUrl + '/checkout';
    try {
      window.location.href = checkoutUrl;
    } catch(err) {
      console.warn('Checkout navigation:', err);
    }
  }

  function addCrossSellItem(btn, variantId) {
    if (!variantId) {
      console.warn('addCrossSellItem: No variant ID provided');
      return;
    }
    btn.disabled = true;
    const oldHtml = btn.innerHTML;
    btn.innerHTML = '...';

    const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    const addUrl = `${rootUrl}cart/add.js`;

    fetch(addUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: Number(variantId),
        quantity: 1,
        sections: 'cart-drawer,cart-icon-bubble'
      })
    })
      .then(res => res.json())
      .then(data => {
        const cartDrawer = document.querySelector('cart-drawer');
        if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
          cartDrawer.renderContents(data);
        } else {
          fetch(`${rootUrl}cart?section_id=cart-drawer`)
            .then(r => r.text())
            .then(htmlStr => {
              const parsed = new DOMParser().parseFromString(htmlStr, 'text/html');
              const newInner = parsed.querySelector('.drawer__inner');
              const curInner = document.querySelector('.drawer__inner');
              if (newInner && curInner) {
                curInner.innerHTML = newInner.innerHTML;
              }
            });
        }
        if (window.PUB_SUB_EVENTS && typeof window.publish === 'function') {
          window.publish(window.PUB_SUB_EVENTS.cartUpdate, { source: 'cart-upsell', cartData: data });
        }
      })
      .catch(err => {
        console.error('Error adding cross-sell product:', err);
        btn.disabled = false;
        btn.innerHTML = oldHtml;
      });
  }
</script>
