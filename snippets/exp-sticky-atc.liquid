{% comment %}
  Renders the Floating Sticky Add to Cart Bar for Mobile (and Desktop scroll trigger).
  Accepts:
  - product: {Object} Product Liquid object
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign compare_at = current_variant.compare_at_price | default: 210000000
  assign price = current_variant.price | default: 165000000
  assign featured_img = product.featured_image | default: product.images.first
-%}

<div class="exp-sticky-atc" id="exp-sticky-atc-{{ section.id }}">
  <div class="exp-sticky-atc__summary">
    <div class="exp-sticky-atc__product">
      {%- if featured_img -%}
        <img
          src="{{ featured_img | image_url: width: 80 }}"
          alt="{{ product.title | escape }}"
          class="exp-sticky-atc__thumb"
          width="36"
          height="36"
          loading="lazy"
        >
      {%- else -%}
        <div class="exp-sticky-atc__thumb" style="display:flex;align-items:center;justify-content:center;background:#e5e7eb;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          </svg>
        </div>
      {%- endif -%}

      <div class="exp-sticky-atc__details">
        <span class="exp-sticky-atc__name">{{ product.title | default: 'Always Pan 2.0' }}</span>
        <span class="exp-sticky-atc__variant">
          {%- if current_variant.title != 'Default Title' -%}
            {{ current_variant.title }}
          {%- else -%}
            Spice &bull; 28cm
          {%- endif -%}
        </span>
      </div>
    </div>

    <div class="exp-sticky-atc__pricing">
      <span class="exp-sticky-atc__compare">
        {{ cart.currency.symbol | default: 'Rp' }}
        {%- if compare_at != blank -%}
          {{ compare_at | money_without_currency | remove: ',00' }}
        {%- else -%}
          2.100.000
        {%- endif -%}
      </span>
      <span class="exp-sticky-atc__current">
        {{ cart.currency.symbol | default: 'Rp' }}
        {%- if price != blank -%}
          {{ price | money_without_currency | remove: ',00' }}
        {%- else -%}
          1.650.000
        {%- endif -%}
      </span>
    </div>
  </div>

  <button type="button" class="exp-sticky-atc__btn" aria-label="Tambah ke Keranjang">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </svg>
    <span>
      Tambah ke Keranjang &bull; {{ cart.currency.symbol | default: 'Rp' }}
      {%- if price != blank -%}
        {{ price | money_without_currency | remove: ',00' }}
      {%- else -%}
        1.650.000
      {%- endif -%}
    </span>
  </button>

  {% render 'exp-trust-badges' %}
</div>
