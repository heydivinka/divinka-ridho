{% comment %}
  Renders the Floating Sticky Add to Cart Bar for Mobile (and Desktop scroll trigger).
  Controlled via `Product information` section schema settings in sections/main-product.liquid.
  Accepts:
  - product: {Object} Product Liquid object
  - section: {Object} Section object with sticky ATC settings
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign price = current_variant.price
  assign compare_at = current_variant.compare_at_price
  assign has_compare = false
  if compare_at != blank and price != blank and compare_at > price
    assign has_compare = true
  endif
  assign featured_img = current_variant.featured_image | default: product.featured_image | default: product.images.first

  assign desktop_width = section.settings.sticky_atc_desktop_width | default: 980
  assign is_full_width = section.settings.sticky_atc_desktop_full_width | default: false
  assign btn_label = section.settings.sticky_atc_button_label | default: 'Tambah ke Keranjang'
  assign show_trust = section.settings.sticky_atc_show_trust_badges
  if show_trust == nil
    assign show_trust = true
  endif
-%}

<div
  class="exp-sticky-atc{% if is_full_width %} exp-sticky-atc--full-width{% endif %}"
  id="exp-sticky-atc-{{ section.id }}"
  style="--exp-sticky-desktop-width: {{ desktop_width }}px;"
  data-button-label="{{ btn_label | escape }}"
>
  <div class="exp-sticky-atc__inner">
    <div class="exp-sticky-atc__summary">
      <div class="exp-sticky-atc__product">
        {%- if featured_img -%}
          <img
            src="{{ featured_img | image_url: width: 100 }}"
            alt="{{ product.title | escape }}"
            class="exp-sticky-atc__thumb"
            width="40"
            height="40"
            loading="lazy"
          >
        {%- else -%}
          <div class="exp-sticky-atc__thumb" style="display:flex;align-items:center;justify-content:center;background:#e5e7eb;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            </svg>
          </div>
        {%- endif -%}

        <div class="exp-sticky-atc__details">
          <span class="exp-sticky-atc__name">{{ product.title | escape }}</span>
          {%- unless product.has_only_default_variant -%}
            <span class="exp-sticky-atc__variant">
              {{ current_variant.title | replace: ' / ', ' • ' }}
            </span>
          {%- endunless -%}
        </div>
      </div>

      <div class="exp-sticky-atc__pricing">
        <span class="exp-sticky-atc__compare"{% unless has_compare %} style="display:none;"{% endunless %}>
          {%- if has_compare -%}
            {{ cart.currency.symbol | default: 'Rp' }} {{ compare_at | money_without_currency | remove: ',00' }}
          {%- endif -%}
        </span>
        <span class="exp-sticky-atc__current">
          {%- if price != blank -%}
            {{ cart.currency.symbol | default: 'Rp' }} {{ price | money_without_currency | remove: ',00' }}
          {%- endif -%}
        </span>
      </div>
    </div>

    <button
      type="button"
      class="exp-sticky-atc__btn"
      aria-label="{{ btn_label | escape }}"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 8h12l1.2 12.2a1 1 0 0 1-1 .8H5.8a1 1 0 0 1-1-.8L6 8z"></path>
        <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
      </svg>
      <span>
        {%- if current_variant.available -%}
          {{ btn_label | escape }}{% if price != blank %} &bull; {{ cart.currency.symbol | default: 'Rp' }} {{ price | money_without_currency | remove: ',00' }}{% endif %}
        {%- else -%}
          Stok Habis
        {%- endif -%}
      </span>
    </button>
  </div>

  {%- if show_trust -%}
    {% render 'exp-trust-badges' %}
  {%- endif -%}
</div>
