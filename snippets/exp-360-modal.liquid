{% comment %}
  Renders the 360° interactive view modal for the product.
  Accepts:
  - product: {Object} Product Liquid object
{% endcomment %}

<div class="exp-360-modal" id="Exp360Modal-{{ section.id }}" role="dialog" aria-modal="true" aria-labelledby="Exp360Title">
  <div class="exp-360-modal__content">
    <button type="button" class="exp-360-modal__close" aria-label="Close modal">&times;</button>
    <h3 class="exp-360-modal__title" id="Exp360Title">{{ product.title | default: 'Always Essential Pan 2.0' }} - 360° View</h3>
    <p class="exp-360-modal__subtitle">Geser kursor atau swipe layar untuk memutar produk 360 derajat.</p>
    
    <div class="exp-360-viewer-area">
      {%- assign featured_img = product.featured_image | default: product.images.first -%}
      {%- if featured_img -%}
        <img
          src="{{ featured_img | image_url: width: 800 }}"
          alt="{{ product.title | escape }}"
          width="800"
          height="800"
          loading="lazy"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}

      <div class="exp-360-drag-hint">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="7 10 2 12 7 14"></polyline>
          <polyline points="17 10 22 12 17 14"></polyline>
          <line x1="2" y1="12" x2="22" y2="12"></line>
        </svg>
        <span>Geser untuk memutar</span>
      </div>
    </div>
  </div>
</div>
