{% comment %}
  Renders the custom Color Swatches variant picker.
  Fully data-driven from Shopify product options & compatible with Dawn's <variant-selects>.
  Accepts:
  - product: {Object} Product Liquid object
  - block: {Object} Block object with settings
  - option: {Object} Option object inside variant-selects loop
  - product_form_id: {String} Product form ID
{% endcomment %}

{%- if option != blank -%}
  {%- liquid
    assign form_id = product_form_id | default: 'product-form-' | append: section.id
    assign selected_color = option.selected_value | upcase
  -%}

  <fieldset class="js product-form__input exp-color-section" {{ block.shopify_attributes }}>
    <legend class="visually-hidden">{{ option.name | escape }}</legend>
    <div class="exp-color-label-row">
      <span class="exp-color-label">
        {{ option.name }}: <span class="exp-color-selected-name" data-selected-value>{{ selected_color }}</span>
      </span>
      <span class="exp-color-tag">— TERLARIS</span>
    </div>

    <div class="exp-swatches-grid">
      {%- for value in option.values -%}
        {%- liquid
          assign val_lower = value | downcase
          assign escaped_value = value | escape
          assign option_disabled = true
          if value.available
            assign option_disabled = false
          endif

          assign swatch_style = ''
          if value.swatch.image
            assign swatch_img_url = value.swatch.image | image_url: width: 80
            assign swatch_style = 'background-image: url(' | append: swatch_img_url | append: '); background-size: cover; background-position: center;'
          elsif value.swatch.color
            assign swatch_style = 'background-color: rgb(' | append: value.swatch.color.rgb | append: ');'
          endif
        -%}
        {%- capture input_id -%}
          {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
        {%- endcapture -%}
        {%- capture input_name -%}
          {{ option.name }}-{{ option.position }}
        {%- endcapture -%}

        <label
          class="exp-swatch-item{% if option_disabled %} exp-swatch-item--unavailable{% endif %}"
          title="{{ escaped_value }}"
          for="{{ input_id }}"
        >
          <input
            type="radio"
            id="{{ input_id }}"
            name="{{ input_name | escape }}"
            value="{{ escaped_value }}"
            form="{{ form_id }}"
            data-product-url="{{ value.product_url }}"
            data-option-value-id="{{ value.id }}"
            data-option-name="{{ option.name | escape }}"
            {% if value.selected %}checked{% endif %}
            {% if option_disabled %}class="disabled"{% endif %}
          >
          <span
            class="exp-swatch-circle"
            data-color="{{ val_lower }}"
            {% if swatch_style != blank %}style="{{ swatch_style }}"{% endif %}
            aria-hidden="true"
          ></span>
        </label>
      {%- endfor -%}
    </div>
  </fieldset>
{%- endif -%}
