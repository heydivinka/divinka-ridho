{% comment %}
  Renders the EXP Smart Description unified component (100% Dynamic from product.description):
  1. Top: Box Checklist 2 Kolom — otomatis diekstrak dari Heading (H2/H3) yang cocok keyword
     ("termasuk", "dalam pembelian", "kelengkapan", "isi paket", "what's included", "in the box")
     beserta daftar bullet (<ul><li>) di bawahnya. Tidak tampil jika tidak ada di deskripsi.
  2. Middle: Komentar Pembeli Terverifikasi — statis via schema Theme Editor (toggleable).
  3. Bottom: Smart Description Accordions — setiap Heading (H2/H3) lainnya di product.description
     otomatis menjadi 1 tab accordion (judul, isi, dan ikon otomatis sesuai keyword).

  Accepts:
  - product: {Object} Product Liquid object
  - block: {Object} Optional Block object (if used as block inside main-product)
  - section: {Object} Optional Section object (if used inside exp-smart-description section)
{% endcomment %}

{%- liquid
  assign source = block.settings | default: section.settings

  # 1. Dynamic Smart Description settings
  assign show_included_box = source.show_included_box
  if show_included_box == nil
    assign show_included_box = source.show_included_items
  endif
  if show_included_box == nil
    assign show_included_box = true
  endif

  assign open_first_accordion = source.open_first_accordion
  if open_first_accordion == nil
    assign open_first_accordion = source.tab_1_open_by_default
  endif
  if open_first_accordion == nil
    assign open_first_accordion = true
  endif

  # 2. Testimonial settings (static via schema)
  assign show_testimonial = source.show_testimonial
  if show_testimonial == nil
    assign show_testimonial = true
  endif
  assign initials = source.testimonial_initials | default: 'AS'
  assign author = source.testimonial_author | default: 'Amanda S.'
  assign badge = source.testimonial_badge | default: 'Pembeli Terverifikasi'
  assign quote = source.testimonial_quote | default: '“Wajan terbaik yang pernah saya beli! Telur meluncur mulus tanpa minyak banyak, mudah dicuci, dan warnanya bikin meja dapur terlihat mewah.”'

  # 3. Parse product.description dynamically by H2/H3 headings
  assign raw_desc = product.description | default: ''
  assign clean_desc = raw_desc | replace: '<blockquote>', '' | replace: '</blockquote>', ''
  assign desc_lower_check = clean_desc | downcase
  assign has_headings = false
  if desc_lower_check contains '<h2' or desc_lower_check contains '<h3'
    assign has_headings = true
  endif

  assign included_title = ''
  assign included_items_joined = ''
  assign intro_html = ''
  assign parsed_accordion_titles = ''
  assign parsed_accordion_bodies = ''
  assign parsed_accordion_icons = ''

  if has_headings
    assign normalized = clean_desc | replace: '<H2', '<h2' | replace: '</H2>', '</h2>' | replace: '<H3', '<h3' | replace: '</H3>', '</h3>'
    assign normalized = normalized | replace: '<h2', '[[EXP_H]]<h2' | replace: '<h3', '[[EXP_H]]<h3'
    assign normalized = normalized | replace: '</h2>', '[[/EXP_H]]' | replace: '</h3>', '[[/EXP_H]]'
    assign chunks = normalized | split: '[[EXP_H]]'

    for chunk in chunks
      if forloop.first
        assign intro_text_check = chunk | strip_html | strip
        assign intro_lower = intro_text_check | downcase
        if intro_text_check != blank
          unless intro_lower contains 'this is a demonstration store'
            assign intro_html = chunk | strip
          endunless
        endif
      else
        assign parts = chunk | split: '[[/EXP_H]]'
        assign raw_heading = parts[0] | default: ''
        assign heading_text = raw_heading | append: '</h3></h2>' | strip_html | strip
        assign heading_lower = heading_text | downcase
        assign section_body = parts[1] | default: '' | strip

        if heading_text != blank
          # Check if this heading is the "Termasuk Dalam Pembelian" checklist block
          assign is_included_section = false
          if heading_lower contains 'termasuk' or heading_lower contains 'dalam pembelian' or heading_lower contains 'kelengkapan' or heading_lower contains 'isi paket' or heading_lower contains "what's included" or heading_lower contains 'whats included' or heading_lower contains 'in the box'
            assign is_included_section = true
          endif

          if is_included_section
            assign last_char = heading_text | slice: -1
            if last_char == ':'
              assign included_title = heading_text
            else
              assign included_title = heading_text | append: ':'
            endif

            # Extract bullet list items (<li>), fallback to <p> lines if no <ul>
            if section_body contains '<li' or section_body contains '<LI'
              assign li_chunks = section_body | replace: '<LI', '<li' | replace: '</LI>', '</li>' | split: '</li>'
              for li_chunk in li_chunks
                if li_chunk contains '<li'
                  assign li_inner = li_chunk | split: '<li' | last
                  assign li_text = '<li' | append: li_inner | append: '</li>' | strip_html | strip
                  if li_text != blank
                    if included_items_joined != blank
                      assign included_items_joined = included_items_joined | append: '[[EXP_ITEM]]'
                    endif
                    assign included_items_joined = included_items_joined | append: li_text
                  endif
                endif
              endfor
            else
              assign p_chunks = section_body | replace: '</P>', '</p>' | split: '</p>'
              for p_chunk in p_chunks
                assign p_text = p_chunk | append: '</p>' | strip_html | strip
                if p_text != blank
                  if included_items_joined != blank
                    assign included_items_joined = included_items_joined | append: '[[EXP_ITEM]]'
                  endif
                  assign included_items_joined = included_items_joined | append: p_text
                endif
              endfor
            endif
          else
            # Regular accordion section — determine icon automatically by heading keyword
            assign tab_icon = 'cookware'
            if heading_lower contains 'garansi' or heading_lower contains 'uji coba' or heading_lower contains 'bebas risiko' or heading_lower contains 'jaminan' or heading_lower contains 'pengembalian' or heading_lower contains 'pengiriman' or heading_lower contains 'warranty' or heading_lower contains 'return' or heading_lower contains 'shipping'
              assign tab_icon = 'clock'
            elsif heading_lower contains 'spesifikasi' or heading_lower contains 'material' or heading_lower contains 'bahan' or heading_lower contains 'ukuran' or heading_lower contains 'dimensi' or heading_lower contains 'non-toxic' or heading_lower contains 'komposisi' or heading_lower contains 'specs' or heading_lower contains 'ingredients' or heading_lower contains 'detail'
              assign tab_icon = 'shield'
            endif

            # Prepend intro_html (if any) to the very first accordion
            if parsed_accordion_titles == blank and intro_html != blank
              assign section_body = intro_html | append: section_body
            endif

            if parsed_accordion_titles != blank
              assign parsed_accordion_titles = parsed_accordion_titles | append: '[[EXP_TAB]]'
              assign parsed_accordion_bodies = parsed_accordion_bodies | append: '[[EXP_TAB]]'
              assign parsed_accordion_icons = parsed_accordion_icons | append: '[[EXP_TAB]]'
            endif
            assign parsed_accordion_titles = parsed_accordion_titles | append: heading_text
            assign parsed_accordion_bodies = parsed_accordion_bodies | append: section_body
            assign parsed_accordion_icons = parsed_accordion_icons | append: tab_icon
          endif
        endif
      endif
    endfor
  elsif clean_desc != blank
    # Fallback for legacy products without H2/H3 headings (e.g., demo products):
    # Separate descriptive paragraphs vs short spec paragraphs — zero hardcoded dummy text
    assign legacy_desc_html = ''
    assign legacy_spec_html = ''
    assign paragraphs = clean_desc | replace: '</P>', '</p>' | split: '</p>'
    for p in paragraphs
      assign p_str = p | strip
      if p_str != blank
        assign p_text = p_str | append: '</p>' | strip_html | strip
        assign p_lower = p_text | downcase
        if p_text != blank
          unless p_lower contains 'this is a demonstration store'
            assign p_full = p_str
            unless p_full contains '</form>' or p_full contains '</ul>' or p_full contains '</ol>'
              assign p_full = p_full | append: '</p>'
            endunless
            assign is_legacy_spec = false
            if p_text.size < 100
              if p_lower contains 'oz' or p_lower contains '454g' or p_lower contains '468g' or p_lower contains 'pack size' or p_lower contains 'spesifikasi' or p_lower contains 'dimensi' or p_lower contains 'material:'
                assign is_legacy_spec = true
              endif
            endif
            if is_legacy_spec
              assign legacy_spec_html = legacy_spec_html | append: p_full
            else
              assign legacy_desc_html = legacy_desc_html | append: p_full
            endif
          endunless
        endif
      endif
    endfor

    if legacy_desc_html != blank
      assign parsed_accordion_titles = 'Deskripsi & Keunggulan'
      assign parsed_accordion_bodies = legacy_desc_html
      assign parsed_accordion_icons = 'cookware'
    endif

    if legacy_spec_html != blank
      if parsed_accordion_titles != blank
        assign parsed_accordion_titles = parsed_accordion_titles | append: '[[EXP_TAB]]'
        assign parsed_accordion_bodies = parsed_accordion_bodies | append: '[[EXP_TAB]]'
        assign parsed_accordion_icons = parsed_accordion_icons | append: '[[EXP_TAB]]'
      endif
      assign parsed_accordion_titles = parsed_accordion_titles | append: 'Spesifikasi'
      assign parsed_accordion_bodies = parsed_accordion_bodies | append: legacy_spec_html
      assign parsed_accordion_icons = parsed_accordion_icons | append: 'shield'
    endif
  endif

  assign included_items = included_items_joined | split: '[[EXP_ITEM]]'
  assign accordion_titles = parsed_accordion_titles | split: '[[EXP_TAB]]'
  assign accordion_bodies = parsed_accordion_bodies | split: '[[EXP_TAB]]'
  assign accordion_icons = parsed_accordion_icons | split: '[[EXP_TAB]]'
-%}

<div class="exp-smart-description" {% if block %}{{ block.shopify_attributes }}{% endif %}>
  {%- comment -%} 1. BAGIAN ATAS: TERMASUK DALAM PEMBELIAN (100% DINAMIS DARI PRODUCT DESCRIPTION) {%- endcomment -%}
  {%- if show_included_box and included_items_joined != blank -%}
    <div class="exp-included-box">
      <div class="exp-included-box__title">{{ included_title }}</div>
      <div class="exp-included-box__grid">
        {%- for item in included_items -%}
          {%- if item != blank -%}
            <div class="exp-included-item">
              <span class="exp-included-item__check" aria-hidden="true">&#10003;</span>
              <span class="exp-included-item__text">{{ item }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} 2. BAGIAN TENGAH: KOMENTAR PEMBELI TERVERIFIKASI (STATIS VIA SCHEMA) {%- endcomment -%}
  {%- if show_testimonial -%}
    <div class="exp-testimonial-card">
      <div class="exp-testimonial-avatar">{{ initials }}</div>
      <div class="exp-testimonial-meta">
        <div class="exp-testimonial-stars-row">
          <span class="exp-stars" aria-label="5 out of 5 stars">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {%- endfor -%}
          </span>
          <span class="exp-testimonial-author">{{ author }}</span>
          <span class="exp-testimonial-badge">{{ badge }}</span>
        </div>
        <p class="exp-testimonial-quote">{{ quote }}</p>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} 3. BAGIAN BAWAH: SMART DESCRIPTION ACCORDIONS (100% DINAMIS DARI PRODUCT DESCRIPTION) {%- endcomment -%}
  {%- if parsed_accordion_titles != blank or section.blocks.size > 0 -%}
    <div class="exp-accordions-group">
      {%- if parsed_accordion_titles != blank -%}
        {%- for tab_title in accordion_titles -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign tab_body = accordion_bodies[idx] -%}
          {%- assign tab_icon = accordion_icons[idx] | default: 'cookware' -%}
          <details class="exp-accordion-item" {% if forloop.first and open_first_accordion %}open{% endif %}>
            <summary class="exp-accordion-header">
              <div class="exp-accordion-header__left">
                <span class="exp-accordion-icon">
                  {%- case tab_icon -%}
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <polyline points="9 12 11 14 15 10"></polyline>
                      </svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 11h16a1 1 0 0 1 1 1v6a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-6a1 1 0 0 1 1-1z"></path>
                        <path d="M9 11V8a3 3 0 0 1 6 0v3"></path>
                        <line x1="2" y1="13" x2="4" y2="13"></line>
                        <line x1="20" y1="13" x2="22" y2="13"></line>
                      </svg>
                  {%- endcase -%}
                </span>
                <span class="exp-accordion-title">{{ tab_title }}</span>
              </div>
              <span class="exp-accordion-chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="exp-accordion-body rte">
              {{ tab_body }}
            </div>
          </details>
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Optional additional blocks on standalone section {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        {%- for sec_block in section.blocks -%}
          {%- if sec_block.type == 'accordion_tab' -%}
            <details class="exp-accordion-item" {{ sec_block.shopify_attributes }}>
              <summary class="exp-accordion-header">
                <div class="exp-accordion-header__left">
                  <span class="exp-accordion-icon">
                    {%- case sec_block.settings.icon -%}
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                          <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                      {%- when 'clock' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M4 11h16a1 1 0 0 1 1 1v6a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-6a1 1 0 0 1 1-1z"></path>
                          <path d="M9 11V8a3 3 0 0 1 6 0v3"></path>
                        </svg>
                    {%- endcase -%}
                  </span>
                  <span class="exp-accordion-title">{{ sec_block.settings.heading | escape }}</span>
                </div>
                <span class="exp-accordion-chevron" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="exp-accordion-body rte">
                {%- if sec_block.settings.content != blank -%}
                  {{ sec_block.settings.content }}
                {%- elsif sec_block.settings.page != blank -%}
                  {{ sec_block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
