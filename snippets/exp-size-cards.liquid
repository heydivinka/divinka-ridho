{% comment %}
  Renders the custom Size Cards variant picker.
  Fully data-driven from Shopify product options & compatible with Dawn's <variant-selects>.
  Accepts:
  - product: {Object} Product Liquid object
  - block: {Object} Block object with settings
  - option: {Object} Option object inside variant-selects loop
  - product_form_id: {String} Product form ID
{% endcomment %}

{%- if option != blank -%}
  {%- liquid
    assign form_id = product_form_id | default: 'product-form-' | append: section.id
    assign selected_size = option.selected_value | upcase
  -%}

  <fieldset class="js product-form__input exp-size-section" {{ block.shopify_attributes }}>
    <legend class="visually-hidden">{{ option.name | escape }}</legend>
    <div class="exp-size-label-row">
      <span class="exp-size-label">
        {{ option.name }}: <span class="exp-size-selected-name" data-selected-value>{{ selected_size }}</span>
      </span>
      {%- if product.selected_or_first_available_variant.available -%}
        <span class="exp-stock-badge">Ready Stock</span>
      {%- else -%}
        <span class="exp-stock-badge" style="background-color:#fee2e2;color:#b91c1c;">Stok Habis</span>
      {%- endif -%}
    </div>

    <div class="exp-size-cards-grid">
      {%- for value in option.values -%}
        {%- liquid
          assign val_lower = value | downcase
          assign escaped_value = value | escape
          assign option_disabled = true
          if value.available
            assign option_disabled = false
          endif
        -%}
        {%- capture input_id -%}
          {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
        {%- endcapture -%}
        {%- capture input_name -%}
          {{ option.name }}-{{ option.position }}
        {%- endcapture -%}

        <label class="exp-size-card{% if option_disabled %} exp-size-card--unavailable{% endif %}" for="{{ input_id }}">
          <input
            type="radio"
            id="{{ input_id }}"
            name="{{ input_name | escape }}"
            value="{{ escaped_value }}"
            form="{{ form_id }}"
            data-product-url="{{ value.product_url }}"
            data-option-value-id="{{ value.id }}"
            data-option-name="{{ option.name | escape }}"
            {% if value.selected %}checked{% endif %}
            {% if option_disabled %}class="disabled"{% endif %}
          >
          <div class="exp-size-card__box">
            <span class="exp-size-card__title">{{ value }}</span>
            {%- liquid
              assign subtitle_text = ''
              if val_lower contains 'mini' or val_lower contains '21'
                assign subtitle_text = '1–2 Porsi'
              elsif val_lower contains 'standar' or val_lower contains '28'
                assign subtitle_text = '3–4 Porsi'
              elsif val_lower contains 'family' or val_lower contains '32'
                assign subtitle_text = '5–7 Porsi'
              elsif val_lower contains 'porsi'
                assign subtitle_text = value
              endif
            -%}
            {%- if subtitle_text != blank -%}
              <span class="exp-size-card__subtitle">{{ subtitle_text }}</span>
            {%- endif -%}
            {%- if val_lower contains 'standar' or val_lower contains '28' or val_lower contains 'favorit' -%}
              <span class="exp-size-card__tag">(Favorit)</span>
            {%- endif -%}
          </div>
        </label>
      {%- endfor -%}
    </div>
  </fieldset>
{%- endif -%}
