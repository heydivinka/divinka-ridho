{% comment %}
  Renders the micro-trust badges row under the buy buttons / in sticky bar.
  Pixel-matched to mobile reference with emerald green icons (#059669).
  Accepts:
  - block: {Object} Optional Block object with settings
{% endcomment %}

<div class="exp-trust-badges" {% if block %}{{ block.shopify_attributes }}{% endif %}>
  <span class="exp-trust-badge-item">
    <svg class="exp-trust-icon exp-trust-icon--check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="4 10.5 8 14.5 16 6"></polyline>
    </svg>
    <span>Garansi 100 Hari</span>
  </span>
  <span class="exp-trust-dot" aria-hidden="true">&bull;</span>
  <span class="exp-trust-badge-item">
    <svg class="exp-trust-icon exp-trust-icon--lock" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
    </svg>
    <span>Checkout Aman</span>
  </span>
  <span class="exp-trust-dot" aria-hidden="true">&bull;</span>
  <span class="exp-trust-badge-item">
    <svg class="exp-trust-icon exp-trust-icon--truck" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M2 5.5A1.5 1.5 0 013.5 4h11A1.5 1.5 0 0116 5.5V9h3.17a1.5 1.5 0 011.2.6l1.93 2.58c.13.18.2.39.2.62V16a1.5 1.5 0 01-1.5 1.5h-.62a3 3 0 01-5.76 0H9.38a3 3 0 01-5.76 0H3.5A1.5 1.5 0 012 16V5.5zm14 5.5v3h4.5v-1.08L18.92 11H16zM6.5 18.5a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm11 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
    </svg>
    <span>Bebas Ongkir</span>
  </span>
</div>
